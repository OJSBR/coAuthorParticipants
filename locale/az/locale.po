#, fuzzy
msgid "plugins.generic.coAuthorParticipants.email.accessNewAccount"
msgstr "<p>Sizin üçün <strong>{$username}</strong> istifadəçi adı ilə hesab yaradılıb. Şifrənizi seçmək üçün {$days} gün etibarlı olan bu təhlükəsiz linkdən istifadə edin: <a href=\"{$passwordResetUrl}\">{$passwordResetUrl}</a></p>"

