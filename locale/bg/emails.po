#, fuzzy
msgid "emails.coauthorParticipantAssigned.name"
msgstr "Съавтор, свързан като участник в изпратен материал"

#, fuzzy
msgid "emails.coauthorParticipantAssigned.description"
msgstr "Изпраща се до съавтор, когато плъгинът „Съавтори като участници“ свърже акаунта му с изпратен материал като участник с ролята на автор."

#, fuzzy
msgid "emails.coauthorParticipantAssigned.variable.accountAccessInstructions"
msgstr "Как се осъществява достъп до акаунта: потребителското име и връзка за задаване на парола при нов акаунт или напомняне за използване на текущите данни за вход при съществуващ акаунт"

#, fuzzy
msgid "emails.coauthorParticipantAssigned.variable.passwordResetUrl"
