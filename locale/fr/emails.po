msgid "emails.coauthorParticipantAssigned.name"
msgstr "Coauteur lié en tant que participant à la soumission"

msgid "emails.coauthorParticipantAssigned.description"
msgstr "Envoyé à un coauteur lorsque son compte est lié à une soumission en tant que participant avec le rôle d'auteur, par le module Coauteurs participants."

msgid "emails.coauthorParticipantAssigned.variable.accountAccessInstructions"
msgstr "Comment accéder au compte : le nom d'utilisateur et un lien pour définir le mot de passe d'un nouveau compte, ou un rappel d'utiliser les identifiants actuels pour un compte existant"

msgid "emails.coauthorParticipantAssigned.variable.passwordResetUrl"
msgstr "Lien sécurisé et temporaire pour définir le mot de passe d'un compte créé par le module (vide pour les comptes existants)"

msgid "emails.coauthorParticipantAssigned.subject"
msgstr "Vous participez désormais à la soumission {$submissionId}"

msgid "emails.coauthorParticipantAssigned.body"
msgstr "<p>{$recipientName},</p><p>Vous figurez parmi les coauteurs de la soumission « {$submissionTitle} », reçue par {$contextName}.</p><p>Votre compte a été lié à la soumission en tant que participant. Vous pouvez désormais suivre son avancement éditorial et accéder aux informations mises à la disposition des auteurs.</p><p>Identifiant de la soumission : {$submissionId}<br />Nom d'utilisateur : {$recipientUsername}<br />Accès : <a href=\"{$authorSubmissionUrl}\">{$authorSubmissionUrl}</a></p>{$accountAccessInstructions}<p>Pour toute question, veuillez nous contacter à l'adresse {$contactEmail}.</p>{$contextSignature}"
