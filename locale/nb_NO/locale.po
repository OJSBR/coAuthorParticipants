msgstr "Skriv hver koblingshandling til applikasjonens feillogg (feil skrives alltid)"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.email.accessNewAccount"
msgstr "<p>Det er opprettet en konto for deg med brukernavnet <strong>{$username}</strong>. Bruk denne sikre lenken, som er gyldig i {$days} dager, for å velge passord: <a href=\"{$passwordResetUrl}\">{$passwordResetUrl}</a></p>"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.email.accessExistingAccount"
msgstr "<p>Logg inn med ditt vanlige brukernavn (<strong>{$username}</strong>) og passord. Hvis du ikke husker passordet, kan du tilbakestille det her: <a href=\"{$passwordLostUrl}\">{$passwordLostUrl}</a></p>"
