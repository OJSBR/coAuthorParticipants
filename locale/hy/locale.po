#, fuzzy
msgid "plugins.generic.coAuthorParticipants.displayName"
msgstr "Համահեղինակները որպես մասնակիցներ"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.description"
msgstr "Ներկայացման աջակիցների ցուցակում նշված համահեղինակներին վերածում է օգտատերերի, որոնք հեղինակի դերով մասնակցում են այդ ներկայացման խմբագրական աշխատանքային ընթացքին. գտնում կամ ստեղծում է յուրաքանչյուր հաշիվը, ամսագրում ավելացնում է հեղինակի դերը, նշանակում է նրան ներկայացմանը և ուղարկում է անհատական նամակ։ Գործում է նոր ներկայացումների դեպքում, իսկ հրամանային տողից՝ նաև դեռևս աշխատանքային ընթացքում գտնվող ավելի վաղ ներկայացումների դեպքում։"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.description"
msgstr "Համահեղինակները համադրվում են միայն էլ․ փոստի հասցեով, երբեք՝ անունով։ Գոյություն ունեցող հաշիվները երբեք չեն փոփոխվում կամ վերաակտիվացվում։ Հրամանային տողի tools/backfill.php գործիքը մշակում է պլագինի միացումից առաջ ավարտված ներկայացումները։"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.acknowledgement.title"
msgstr "Ներկայացման ստացման հաստատում"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.acknowledgement.changed"
msgstr "Պլագինը միացնելիս ներկայացումն ավարտվելու ժամանակ ուղարկվող ստացման հաստատումը «բոլոր հեղինակներին» տարբերակից փոխվել է «միայն ներկայացնող հեղինակին» տարբերակի, որպեսզի յուրաքանչյուր համահեղինակ ստանա միայն պլագինի նամակը։ Նախկին արժեքը վերականգնվում է պլագինն անջատելիս, եթե այդ ընթացքում այն ձեռքով չի փոխվել։"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.acknowledgement.allAuthors"
msgstr "Ամսագիրը կարգավորված է ներկայացման ստացման հաստատումը բոլոր հեղինակներին ուղարկելու համար։ Համահեղինակները կստանան և՛ այդ նամակը, և՛ պլագինի նամակը։ Որպեսզի նրանք ստանան միայն մեկը, Աշխատանքային ընթացք > Էլ․ նամակներ բաժնում ստացման հաստատումը սահմանեք միայն ներկայացնող հեղինակին, կամ անջատեք և նորից միացրեք այս պլագինը։"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.acknowledgement.compatible"
msgstr "Ներկայացման ստացման հաստատումը չի ուղարկվում բոլոր հեղինակներին, ուստի համահեղինակները ստանում են միայն պլագինի նամակը։"

