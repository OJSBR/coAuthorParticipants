#, fuzzy
msgid "plugins.generic.coAuthorParticipants.email.accessNewAccount"
msgstr "<p>تم إنشاء حساب لك باسم الدخول <strong>{$username}</strong>. لاختيار كلمة المرور، يرجى استخدام هذا الرابط الآمن، الصالح لعدد {$days} من الأيام: <a href=\"{$passwordResetUrl}\">{$passwordResetUrl}</a></p>"

#, fuzzy
