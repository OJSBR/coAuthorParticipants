#, fuzzy
msgid "plugins.generic.coAuthorParticipants.displayName"
msgstr "თანაავტორები მონაწილეებად"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.description"
msgstr "შენატანის ავტორთა სიაში მითითებულ თანაავტორებს აქცევს მომხმარებლებად, რომლებიც ავტორის როლით მონაწილეობენ ამ შენატანის სარედაქციო სამუშაო პროცესში: პოულობს ან ქმნის თითოეულის ანგარიშს, ჟურნალში ამატებს ავტორის როლს, ნიშნავს მას შენატანზე და აგზავნის ინდივიდუალურ ელწერილს. მოქმედებს ახალ შენატანებზე, ბრძანების ზოლიდან კი — ასევე ადრინდელ შენატანებზე, რომლებიც ჯერ კიდევ სამუშაო პროცესში არიან."

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.description"
msgstr "თანაავტორები იდენტიფიცირდებიან მხოლოდ ელფოსტის მისამართით, არასოდეს — სახელით. არსებული ანგარიშები არასოდეს იცვლებიან და ხელახლა არ აქტიურდებიან. ბრძანების ზოლის ინსტრუმენტი tools/backfill.php ამუშავებს შენატანებს, რომლებიც დასრულდა პლაგინის ჩართვამდე."

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.acknowledgement.title"
msgstr "შენატანის მიღების დადასტურება"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.acknowledgement.changed"
msgstr "პლაგინის ჩართვისას შენატანის დასრულებისას გასაგზავნი მიღების დადასტურების პარამეტრი შეიცვალა მნიშვნელობიდან „ყველა ავტორი“ მნიშვნელობაზე „შენატანის გამომგზავნი ავტორი“, რათა თითოეულმა თანაავტორმა მიიღოს მხოლოდ პლაგინის ელწერილი. პლაგინის გამორთვისას წინა მნიშვნელობა აღდგება, თუ ის ამ დროის განმავლობაში ხელით არ შეიცვალა."

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.acknowledgement.allAuthors"
msgstr "ჟურნალი დაყენებულია ისე, რომ შენატანის მიღების დადასტურება ეგზავნოს ყველა ავტორს. თანაავტორები მიიღებენ როგორც ამ ელწერილს, ისე პლაგინის ელწერილს. იმისათვის, რომ მიიღონ მხოლოდ ერთი, სამუშაო პროცესი > ელფოსტა განყოფილებაში დააყენეთ მიღების დადასტურების გაგზავნა შენატანის გამომგზავნ ავტორზე, ან გამორთეთ და ხელახლა ჩართეთ ეს პლაგინი."

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.acknowledgement.compatible"
msgstr "შენატანის მიღების დადასტურება ყველა ავტორს არ ეგზავნება, ასე რომ თანაავტორები იღებენ მხოლოდ პლაგინის ელწერილს."

