#, fuzzy
msgid "plugins.generic.coAuthorParticipants.email.accessNewAccount"
msgstr "<p>Для Вас створено обліковий запис з ім'ям користувача <strong>{$username}</strong>. Щоб задати пароль, скористайтеся цим захищеним посиланням, дійсним протягом {$days} дн.: <a href=\"{$passwordResetUrl}\">{$passwordResetUrl}</a></p>"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.email.accessExistingAccount"
