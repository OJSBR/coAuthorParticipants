msgid "plugins.generic.coAuthorParticipants.email.accessNewAccount"
msgstr "<p>Za vas je bil ustvarjen račun z uporabniškim imenom <strong>{$username}</strong>. Za izbiro gesla prosimo uporabite to varno povezavo, ki velja {$days} dni: <a href=\"{$passwordResetUrl}\">{$passwordResetUrl}</a></p>"

