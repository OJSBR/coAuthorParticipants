#, fuzzy
msgid "plugins.generic.coAuthorParticipants.displayName"
msgstr "Soavtorji kot udeleženci"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.description"
msgstr "Soavtorje, navedene med sodelujočimi pri prispevku, spremeni v uporabnike, ki z vlogo avtorja sodelujejo v uredniškem delovnem toku prispevka: poišče ali ustvari račun vsakega od njih, doda vlogo avtorja v reviji, ga dodeli prispevku in pošlje posamičen email. Deluje pri novih prispevkih in, prek ukazne vrstice, pri starejših prispevkih, ki so še v delovnem toku."

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.description"
msgstr "Soavtorji se prepoznajo le po email naslovu, nikoli po imenu. Obstoječi računi se nikoli ne spremenijo ali ponovno aktivirajo. Orodje ukazne vrstice tools/backfill.php obdela prispevke, oddane pred omogočenjem vtičnika."

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.acknowledgement.title"
msgstr "Potrditev oddaje prispevka"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.acknowledgement.changed"
msgstr "Ob omogočenju vtičnika je bila potrditev, ki se pošlje ob zaključku oddaje prispevka, spremenjena iz »vsem avtorjem« v »avtorju, ki je oddal prispevek«, tako da vsak soavtor prejme le email vtičnika. Prejšnja vrednost se obnovi, ko je vtičnik onemogočen, razen če je bila medtem ročno spremenjena."

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.acknowledgement.allAuthors"
msgstr "Revija je nastavljena tako, da potrditev oddaje prispevka pošlje vsem avtorjem. Soavtorji bodo prejeli ta email in tudi email vtičnika. Da bi prejeli le enega, v Delovni tok > Emaili nastavite pošiljanje potrditve le avtorju, ki je oddal prispevek, ali pa ta vtičnik onemogočite in ponovno omogočite."

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.acknowledgement.compatible"
msgstr "Potrditev oddaje prispevka se ne pošilja vsem avtorjem, zato soavtorji prejmejo le email vtičnika."

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.linkingArea"
msgstr "Povezovanje"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.autoLink"
msgstr "Samodejno poveži soavtorje, ko je oddaja prispevka zaključena ali ko je sodelavec dodan prispevku, ki je že v delovnem toku"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.createAccounts"
msgstr "Ustvari račun, ko noben uporabnik nima email naslova soavtorja (ko je izklopljeno, je soavtor zabeležen kot čakajoč)"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.authorUserGroupId"
msgstr "Skupina avtorjev za povezane soavtorje"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.authorUserGroupId.description"
msgstr "Vsak soavtor je povezan s to skupino, ne glede na to, katera skupina je bila zanj izbrana v obrazcu sodelavca. Prikazane so le skupine avtorjev z dostopom do delovnega toka."

#, fuzzy
