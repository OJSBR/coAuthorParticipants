#, fuzzy
msgid "plugins.generic.coAuthorParticipants.email.accessNewAccount"
msgstr "<p>Byl pro Vás vytvořen účet s uživatelským jménem <strong>{$username}</strong>. Heslo si zvolíte pomocí tohoto zabezpečeného odkazu, platného po dobu {$days} dní: <a href=\"{$passwordResetUrl}\">{$passwordResetUrl}</a></p>"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.email.accessExistingAccount"
