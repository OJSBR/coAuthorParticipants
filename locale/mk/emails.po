msgid "emails.coauthorParticipantAssigned.subject"
msgstr "Сега сте учесник во поднесокот {$submissionId}"

#, fuzzy
msgid "emails.coauthorParticipantAssigned.body"
msgstr "<p>Почитуван/а {$recipientName},</p><p>Наведени сте како коавтор на поднесокот „{$submissionTitle}“, примен од {$contextName}.</p><p>Вашата сметка е поврзана со поднесокот како учесник. Отсега можете да го следите неговиот уреднички тек и да пристапувате до информациите достапни за авторите.</p><p>ID на поднесокот: {$submissionId}<br />Корисничко име: {$recipientUsername}<br />Пристап: <a href=\"{$authorSubmissionUrl}\">{$authorSubmissionUrl}</a></p>{$accountAccessInstructions}<p>Доколку имате прашања, ве молиме контактирајте нè на {$contactEmail}.</p>{$contextSignature}"
