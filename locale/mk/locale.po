#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.autoLink"
msgstr "Автоматски поврзувај ги коавторите кога ќе заврши поднесувањето или кога ќе се додаде соработник во поднесок што веќе е во работниот тек"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.createAccounts"
msgstr "Создај сметка кога ниту еден корисник нема имејл адреса на коавторот (кога е исклучено, коавторот се евидентира како на чекање)"

#, fuzzy
