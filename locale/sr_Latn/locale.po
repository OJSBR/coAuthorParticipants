#, fuzzy
msgid "plugins.generic.coAuthorParticipants.displayName"
msgstr "Koautori kao učesnici"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.description"
msgstr "Pretvara koautore navedene među saradnicima predaje u korisnike koji učestvuju u njenom uredničkom procesu rada, sa ulogom autora: pronalazi ili kreira nalog svakog od njih, dodaje ulogu autora u časopisu, dodeljuje ga predaji i šalje pojedinačni imejl. Radi na novim predajama i, putem komandne linije, na ranijim predajama koje su još uvek u procesu rada."

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.description"
msgstr "Koautori se prepoznaju isključivo po imejl adresi, nikada po imenu. Postojeći nalozi se nikada ne menjaju niti ponovo aktiviraju. Alat za komandnu liniju tools/backfill.php obrađuje predaje završene pre nego što je dodatak omogućen."

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.acknowledgement.title"
msgstr "Potvrda prijema predaje"

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.acknowledgement.changed"
msgstr "Prilikom omogućavanja dodatka, potvrda koja se šalje po završetku predaje promenjena je sa „svim autorima“ na „autoru koji je izvršio predaju“, kako bi svaki koautor primio samo imejl dodatka. Prethodna vrednost se vraća kada se dodatak onemogući, osim ako u međuvremenu nije ručno promenjena."

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.acknowledgement.allAuthors"
msgstr "Časopis je podešen da potvrdu prijema predaje šalje svim autorima. Koautori će primiti taj imejl i imejl dodatka. Da bi primali samo jedan, podesite da se potvrda šalje autoru koji je izvršio predaju u Proces rada > Imejlovi, ili onemogućite pa ponovo omogućite ovaj dodatak."

#, fuzzy
msgid "plugins.generic.coAuthorParticipants.settings.acknowledgement.compatible"
msgstr "Potvrda prijema predaje se ne šalje svim autorima, tako da koautori primaju samo imejl dodatka."

